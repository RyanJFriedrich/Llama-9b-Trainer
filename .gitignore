# This repo tracks ONLY train/ (the harness). Everything else at the repo
# root — docs/, data_pipeline/, OriginalModel/, QuantizedModel/,
# LlamaCPPBinaries/, ReferenceCode/, exports/, AGENTS.md, logs — stays local
# to each machine and moves via HF or direct transfer, never via git.
/*
!/train/
!/.gitignore

# Inside train/: no run outputs, data drop zones, or caches
# (README placeholders stay tracked).
__pycache__/
*.pyc
train/runs/*
!train/runs/README.md
train/data/bulk_npz/*
!train/data/bulk_npz/README.md
train/data/shards/*
!train/data/shards/README.md
